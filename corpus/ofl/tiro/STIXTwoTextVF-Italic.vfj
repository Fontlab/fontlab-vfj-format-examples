    "openTypeFeatures":[
      {
        "feature":"languagesystem DFLT dflt;\nlanguagesystem latn dflt;\nlanguagesystem cyrl dflt;\nlanguagesystem grek dflt;\n# Glyph classes\n# Lookups\nlookup l.locl.ROM {\n    sub Scedilla by Scommaaccent;\n    sub Tcedilla by Tcommaaccent;\n    sub scedilla by scommaaccent;\n    sub tcedilla by tcommaaccent;\n} l.locl.ROM;\n\nlookup l.locl.TRK {\n    sub i by i.TRK;\n} l.locl.TRK;\n\nlookup c.locl.SRB_MKD {\n    sub c.be by c.be.SRB;\n    sub c.ghe by c.ghe.SRB;\n    sub c.de by c.de.SRB;\n    sub c.pe by c.pe.SRB;\n    sub c.te by c.te.SRB;\n} c.locl.SRB_MKD;\n\nlookup x.ccmp.markligs {\n    sub circumflexcomb gravecomb by circumflexgravecomb;\n    sub circumflexcomb acutecomb by circumflexacutecomb;\n    sub circumflexcomb tildecomb by circumflextildecomb;\n    sub circumflexcomb hookabovecomb by circumflexhookcomb;\n    sub brevecomb gravecomb by brevegravecomb;\n    sub brevecomb acutecomb by breveacutecomb;\n    sub brevecomb tildecomb by brevetildecomb;\n    sub brevecomb hookabovecomb by brevehookcomb;\n} x.ccmp.markligs;\n\nlookup x.ccmp.capmarks {\n    sub @x.precapmarks gravecomb' by gravecomb.cap;\n    sub @x.precapmarks acutecomb' by acutecomb.cap;\n    sub @x.precapmarks circumflexcomb' by circumflexcomb.cap;\n    sub @x.precapmarks circumflexgravecomb' by circumflexgravecomb.cap;\n    sub @x.precapmarks circumflexacutecomb' by circumflexacutecomb.cap;\n    sub @x.precapmarks circumflextildecomb' by circumflextildecomb.cap;\n    sub @x.precapmarks circumflexhookcomb' by circumflexhookcomb.cap;\n    sub @x.precapmarks tildecomb' by tildecomb.cap;\n    sub @x.precapmarks macroncomb' by macroncomb.cap;\n    sub @x.precapmarks overlinecomb' by overlinecomb.cap;\n    sub @x.precapmarks brevecomb' by brevecomb.cap;\n    sub @x.precapmarks brevegravecomb' by brevegravecomb.cap;\n    sub @x.precapmarks breveacutecomb' by breveacutecomb.cap;\n    sub @x.precapmarks brevetildecomb' by brevetildecomb.cap;\n    sub @x.precapmarks brevehookcomb' by brevehookcom